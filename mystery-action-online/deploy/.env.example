# Variables del despliegue con docker compose (VPS). Copia a deploy/.env y rellena.
# deploy/.env NO se sube nunca al repositorio (está en .gitignore y .dockerignore).

# Dominio que apunta a la IP del servidor (registro DNS de tipo A), sin https:// ni barra final.
DOMAIN=
# Correo para Let's Encrypt (avisos de caducidad del certificado)
ACME_EMAIL=

# Secreto con el que se firman las sesiones (mínimo 32 caracteres). Genéralo en tu equipo con:
#   openssl rand -base64 48
# Si lo cambias, todos tendrán que volver a iniciar sesión (los perfiles no se pierden).
AUTH_SECRET=

# Contraseña de PostgreSQL (solo letras y números para no tener que escaparla). Genérala con:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Segundos que se guarda el sitio de quien pierde la conexión (5-900)
RECONNECT_SECONDS=45
# debug | info | warn | error
LOG_LEVEL=info
