# Variables del servidor. Copia este archivo a .env (en la raíz) y rellénalo; npm run dev:server y npm start lo leen.
# No contiene ningún secreto: genera los tuyos. .env nunca se sube al repositorio.
# Obligatorio en producción. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
NODE_ENV=development
PORT=2567
# Dirección(es) desde las que se abre el juego, separadas por comas, sin barra final.
# En producción es obligatoria y debe ser https:// (p. ej. https://juego.tudominio.es). Controla CORS y WebSockets.
# En desarrollo puedes dejarla vacía: se acepta cualquier origen (útil para probar con otro ordenador de tu red).
CLIENT_ORIGIN=
# Base de datos de perfiles: sqlite (por defecto, archivo DATA_DIR/mystery-action.db) | postgres
PROFILE_STORE=sqlite
DATA_DIR=./data
# SQLITE_FILE=./data/mystery-action.db
# Solo si PROFILE_STORE=postgres:  postgres://USUARIO:CONTRASEÑA@HOST:5432/BASE
DATABASE_URL=
# SOLO DESARROLLO: permitir subir una partida local al perfil online (NO es seguro; en producción se ignora)
ALLOW_PROFILE_IMPORT=false
TOKEN_TTL_HOURS=720
# Proxies de confianza delante del servidor (Caddy, Fly, Render…): 1. Sin proxy (acceso directo): 0.
# Con 1, la IP real del jugador se toma de X-Forwarded-For para los límites de intentos.
TRUST_PROXY=0
# Registros: debug | info | warn | error ; formato json (producción) o pretty (desarrollo)
LOG_LEVEL=info
# LOG_FORMAT=json

# Segundos que se guarda el sitio de quien pierde la conexión en plena expedición (5-900).
# Mientras tanto su personaje queda dormido (quieto e invulnerable) y el grupo sigue jugando.
RECONNECT_SECONDS=45
# Máximo que puede elegir el anfitrión en su sala (entre 30 s, 45 s, 1, 2 y 5 min)
RECONNECT_MAX_SECONDS=300
# Segundos que se espera a un anfitrión desconectado antes de pasar el liderazgo a otro jugador (0-120)
HOST_GRACE_SECONDS=10

# --- Cliente (solo al compilar: npm run build:client) ---
# Dirección https:// del servidor si el cliente se publica en otro dominio (Cloudflare Pages + Fly.io).
# Vacío = el servidor está en la misma dirección que la página (VPS con Caddy).
# SERVER_URL=https://tu-app.fly.dev
